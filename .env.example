# YouTube Data API v3 Key (required for production)
# Get your API key from: https://console.developers.google.com/
# Enable YouTube Data API v3 for your project
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# Legacy API configuration (for PHP backend - optional)
YOUTUBE_API_KEY=your_youtube_api_key_here

# API Base URL (Node.js server with REST endpoints)
# For development: http://localhost:3000
# For production: https://yourdomain.com
VITE_API_BASE_URL=http://localhost:3000

# WebSocket Server URL (required for real-time features)
VITE_SOCKET_URL=http://localhost:3000

# Backend Configuration (Node.js)
PORT=3000
NODE_ENV=development

# OpenAI API Key (SERVER-SIDE ONLY - for AI song recommendations)
# Get your API key from: https://platform.openai.com/api-keys
# IMPORTANT: This is NOT prefixed with VITE_ to keep it secure on the server
# Never expose this key in client-side code!
OPENAI_API_KEY=your_openai_api_key_here